# ---------------------------------------------------------------
# TaskFlow server configuration
# Copy this file to `.env` and adjust the values.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string (MongoDB Atlas or local mongod).
# In development you can leave this empty: the server will start an
# embedded MongoDB (persisted to server/.data) and seed demo data.
MONGO_URI=

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (the React app).
CLIENT_URL=http://localhost:5173

# Seed demo data automatically when the database is empty (true/false).
SEED_ON_EMPTY_DB=true

# Number of reverse proxies in front of the server (1 behind Render or a single nginx).
# Keep 0 when clients connect directly: trusting X-Forwarded-For without a proxy would let
# anyone spoof their IP address and bypass the rate limits.
TRUST_PROXY=0
