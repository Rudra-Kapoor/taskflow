# TaskFlow client configuration (copy to client/.env). Both values are optional.

# Base URL of the REST API, including the /api prefix (e.g. https://api.example.com/api).
# Empty = same origin "/api": in development the Vite dev server proxies it to the server.
VITE_API_URL=

# Origin of the Socket.IO server (e.g. https://api.example.com).
# Empty = the origin of VITE_API_URL, or the page's own origin (Vite proxies /socket.io in dev).
VITE_SOCKET_URL=
